{
  "name": "local-mashup",
  "version": "1.0.0",
  "description": "Simple local mashup",
  "sideEffects": false,
  "scripts": {
    "start": "parcel src/index.html --open --no-hmr --no-source-maps",
    "build": "parcel build src/index.html --dist-dir ./dist --no-cache --no-source-maps",
    "cleanstart": "rm -rf dist && rm -rf .parcel-cache && parcel build src/index.html --dist-dir ./dist --no-source-maps && parcel src/index.html --no-hmr --no-source-maps"
  },
  "dependencies": {
    "@nebula.js/stardust": "latest",
    "qix-faker": "^0.3.0"
  },
  "devDependencies": {
    "@nebula.js/sn-bar-chart": "latest",
    "@nebula.js/sn-line-chart": "latest",
    "buffer": "^6.0.3",
    "parcel": "^2.16.4",
    "process": "^0.11.10"
  }
}
