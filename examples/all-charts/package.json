{
  "name": "mashup-bundle-size",
  "version": "0.1.0",
  "description": "testing if we can remove redundant bundle size while using multiple charts",
  "main": "index.js",
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "clean": "rimraf ./dist/*",
    "build:dev": "webpack serve --config webpack.config.js --progress --env=dev",
    "build:prod": "npm run clean && webpack --config webpack.config.js --progress --env=prod",
    "serve:prod": "serve ./dist"
  },
  "keywords": [
    "mashup",
    "nebula.js"
  ],
  "author": "@amdev (Ahmad Mirzaei)",
  "license": "ISC",
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@material-ui/icons": "npm:@mui/icons-material@^9.5.0",
    "@mui/material": "^9.5.0",
    "@nebula.js/sn-action-button": "latest",
    "@nebula.js/sn-bar-chart": "latest",
    "@nebula.js/sn-bullet-chart": "latest",
    "@nebula.js/sn-combo-chart": "latest",
    "@nebula.js/sn-funnel-chart": "latest",
    "@nebula.js/sn-grid-chart": "latest",
    "@nebula.js/sn-kpi": "latest",
    "@nebula.js/sn-line-chart": "latest",
    "@nebula.js/sn-mekko-chart": "latest",
    "@nebula.js/sn-org-chart": "latest",
    "@nebula.js/sn-pie-chart": "latest",
    "@nebula.js/sn-pivot-table": "latest",
    "@nebula.js/sn-sankey-chart": "latest",
    "@nebula.js/sn-scatter-plot": "latest",
    "@nebula.js/sn-table": "latest",
    "@nebula.js/stardust": "latest",
    "@qlik/api": "^2.19.0",
    "enigma.js": "^2.7.3",
    "hammerjs": "^2.0.8",
    "picasso-plugin-hammer": "^1.2.2",
    "picasso-plugin-q": "^1.2.2",
    "picasso.js": "^1.6.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@babel/core": "^7.15.0",
    "babel-loader": "^8.2.2",
    "compression-webpack-plugin": "^8.0.1",
    "css-loader": "^6.2.0",
    "html-webpack-plugin": "^5.5.0",
    "mini-css-extract-plugin": "^2.2.0",
    "rimraf": "^3.0.2",
    "serve": "^12.0.0",
    "webpack": "^5.101.0",
    "webpack-bundle-analyzer": "^4.4.2",
    "webpack-cli": "^7.2.3",
    "webpack-dev-server": "^6.0.0"
  }
}
