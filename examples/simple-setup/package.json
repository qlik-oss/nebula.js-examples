{
  "name": "mashup-bundle-size",
  "version": "0.1.0",
  "description": "testing if we can remove redundant bundle size while using multiple charts",
  "main": "index.js",
  "scripts": {
    "clean": "rimraf ./dist/*",
    "build:dev": "webpack-dev-server --config webpack.config.js --progress --env=dev",
    "build:prod": "npm run clean && webpack --config webpack.config.js --progress --env=prod",
    "serve:prod": "serve ./dist"
  },
  "keywords": [
    "mashup",
    "nebula.js"
  ],
  "author": "@amdev (Ahmad Mirzaei)",
  "license": "ISC",
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^9.5.0",
    "@nebula.js/sn-bar-chart": "latest",
    "@nebula.js/sn-line-chart": "latest",
    "@nebula.js/sn-scatter-plot": "latest",
    "@nebula.js/stardust": "latest",
    "@qlik/api": "^2.19.0",
    "@qlik/sdk": "^0.9.1",
    "enigma.js": "^2.7.3",
    "hammerjs": "^2.0.8",
    "picasso-plugin-hammer": "^1.2.2",
    "picasso-plugin-q": "^1.2.2",
    "picasso.js": "^1.2.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@babel/core": "^7.15.0",
    "babel-loader": "^8.2.2",
    "css-loader": "^6.2.0",
    "html-webpack-plugin": "^5.3.2",
    "mini-css-extract-plugin": "^2.2.0",
    "rimraf": "^3.0.2",
    "serve": "^12.0.0",
    "webpack": "^5.76.0",
    "webpack-cli": "^4.8.0",
    "webpack-dev-server": "^4.0.0"
  }
}
